<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CommunicationApp"
             x:Class="CommunicationApp.ProvidersPage"
             Title="Providers">

    <!-- The chat list can be long, so it is the scrolling list itself and the providers sit in its header. -->
    <CollectionView x:Name="Chats" IsGrouped="True" Margin="30,0">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="25" Padding="0,0,0,25">
                <Label Text="Receive messages from" FontAttributes="Bold" />
                <Label x:Name="Status" IsVisible="False" />
                <VerticalStackLayout x:Name="Providers" Spacing="25">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ProviderRow">
                            <HorizontalStackLayout Spacing="10">
                                <Switch IsToggled="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding Configured}" Toggled="Provider_OnToggled" />
                                <Label Text="{Binding Title}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label x:Name="ChatsTitle" Text="Telegram chats" FontAttributes="Bold" IsVisible="False" />
                <Label x:Name="ChatsStatus" IsVisible="False" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="local:ChatGroup">
                <Label Text="{Binding Title}" FontAttributes="Bold" Padding="0,15,0,5" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:ChatRow">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,5">
                    <Switch IsToggled="{Binding Enabled, Mode=OneWay}" Toggled="Chat_OnToggled" />
                    <Label Grid.Column="1" Text="{Binding Title}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
