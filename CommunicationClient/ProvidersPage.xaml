<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:CommunicationClient.ViewModels"
             x:Class="CommunicationClient.ProvidersPage"
             x:DataType="viewModels:ProvidersViewModel"
             x:Name="page"
             Title="Providers">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        BindingContext="{Binding BindingContext, Source={x:Reference page}, x:DataType=ContentPage}"
                                        Command="{Binding LoadCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsNotEmpty" />
    </ContentPage.Resources>

    <CollectionView ItemsSource="{Binding ChatGroups}" IsGrouped="True" Margin="30,0">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="25" Padding="0,0,0,25">
                <Label Text="Receive messages from" FontAttributes="Bold" />
                <Label Text="{Binding Status}" IsVisible="{Binding Status, Converter={StaticResource IsNotEmpty}}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Providers}" Spacing="25">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ProviderRow">
                            <HorizontalStackLayout Spacing="10">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Switch IsToggled="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding Configured}" InputTransparent="True" />
                                <Label Text="{Binding Title}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowsTelegram}">
                    <Label Text="Telegram account" FontAttributes="Bold" />
                    <Label Text="{Binding TelegramAccount}" />
                    <Button Text="{Binding LoginText}" IsVisible="{Binding ShowsLogin}" Command="{Binding LoginCommand}" />
                    <Button Text="Log out" IsVisible="{Binding ShowsLogout}" Command="{Binding LogoutCommand}" />
                </VerticalStackLayout>
                <Label Text="Telegram chats" FontAttributes="Bold" IsVisible="{Binding ShowsChats}" />
                <Label Text="{Binding ChatsStatus}" IsVisible="{Binding ChatsStatus, Converter={StaticResource IsNotEmpty}}" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="viewModels:ChatGroup">
                <Label Text="{Binding Title}" FontAttributes="Bold" Padding="0,15,0,5" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="viewModels:ChatRow">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,5">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                    </Grid.GestureRecognizers>
                    <Switch IsToggled="{Binding Enabled, Mode=OneWay}" InputTransparent="True" />
                    <Label Grid.Column="1" Text="{Binding Title}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
