<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CommunicationClient.ViewModels"
             x:Class="CommunicationClient.MainPage"
             x:DataType="viewModels:MainPageViewModel">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry Text="{Binding Backend}" Placeholder="https://localhost:7001" />
            <Button Text="Providers" Command="{Binding OpenProvidersCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
