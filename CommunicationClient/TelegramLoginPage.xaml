<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunicationClient.TelegramLoginPage"
             Title="Telegram login">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label x:Name="Prompt" Text="Loading..." />
            <Entry x:Name="Value" IsVisible="False" Completed="Continue_OnClicked" />
            <Label x:Name="Error" IsVisible="False" />
            <Button x:Name="Continue" Text="Continue" IsVisible="False" Clicked="Continue_OnClicked" />
            <Button x:Name="StartOver" Text="Start over" IsVisible="False" Clicked="StartOver_OnClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
