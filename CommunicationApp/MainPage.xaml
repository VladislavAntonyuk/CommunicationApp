<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:CommunicationApp.ViewModels"
             x:Class="CommunicationApp.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             x:Name="page">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        BindingContext="{Binding BindingContext, Source={x:Reference page}, x:DataType=ContentPage}"
                                        Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior EventName="Disappearing"
                                        BindingContext="{Binding BindingContext, Source={x:Reference page}, x:DataType=ContentPage}"
                                        Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry Text="{Binding PhoneNumber}" Placeholder="From: +380987654321" />
            <HorizontalStackLayout Spacing="10">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleAutoForwardCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Switch IsToggled="{Binding AutoForward, Mode=OneWay}" InputTransparent="True" />
                <Label Text="Forward automatically" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Text="Forward now" Command="{Binding ForwardNowCommand}" />
            <Label Text="{Binding Status}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
