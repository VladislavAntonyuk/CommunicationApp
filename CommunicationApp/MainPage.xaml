<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommunicationApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

			<Entry x:Name="Backend" Placeholder="https://localhost:7001" TextChanged="Backend_OnTextChanged"></Entry>
            <Entry x:Name="PhoneNumber" Placeholder="From: +380987654321" TextChanged="PhoneNumber_OnTextChanged"></Entry>
            <HorizontalStackLayout Spacing="10">
                <Switch x:Name="AutoForward" Toggled="AutoForward_OnToggled" />
                <Label Text="Forward automatically" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Text="Forward now" Clicked="CallButton_OnClicked" />
            <Label x:Name="Status" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>